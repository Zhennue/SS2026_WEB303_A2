FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/product-service ./product-service
FROM alpine:3.21
RUN adduser -D appuser
USER appuser
COPY --from=build /out/product-service /product-service
EXPOSE 50051
ENTRYPOINT ["/product-service"]

