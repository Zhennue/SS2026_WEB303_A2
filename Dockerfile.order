FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -o /out/order-service ./order-service
FROM alpine:3.21
RUN adduser -D appuser
USER appuser
COPY --from=build /out/order-service /order-service
EXPOSE 50052
ENTRYPOINT ["/order-service"]

